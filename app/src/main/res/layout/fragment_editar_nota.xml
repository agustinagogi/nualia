<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/fondo_nualia"
    android:padding="16dp"
    android:fillViewport="true">

    <LinearLayout
        android:id="@+id/contentLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Título -->
        <TextView
            android:id="@+id/tvTituloLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/editar_titulo"
            android:textSize="16sp"
            android:textStyle="bold"
            android:layout_marginBottom="8dp" />

        <EditText
            android:id="@+id/etTitulo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/titulo"
            android:textColorHint="@color/texto"
            android:importantForAutofill="no"
            android:inputType="textCapSentences"
            android:textSize="16sp"
            android:background="@drawable/bg_edittext"
            android:padding="12dp"
            android:layout_marginBottom="16dp" />

        <!-- Descripción -->
        <TextView
            android:id="@+id/tvDescripcionLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/editar_descripcion"
            android:textSize="16sp"
            android:textStyle="bold"
            android:layout_marginBottom="8dp" />

        <EditText
            android:id="@+id/etDescripcion"
            android:layout_width="match_parent"
            android:layout_height="200dp"
            android:gravity="top|start"
            android:hint="@string/descripcion"
            android:textColorHint="@color/texto"
            android:importantForAutofill="no"
            android:textSize="16sp"
            android:background="@drawable/bg_edittext"
            android:padding="12dp"
            android:inputType="textMultiLine"
            android:layout_marginBottom="24dp" />

        <!-- Botón Guardar -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnGuardar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/guardar_cambios"
            android:textAllCaps="false"
            android:backgroundTint="@color/botones"
            android:textColor="@android:color/white"
            android:padding="12dp"
            app:cornerRadius="16dp"
            app:iconPadding="8dp" />

        <!-- Botón Eliminar -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnEliminar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/boton_eliminar"
            android:backgroundTint="@color/botones"
            android:textColor="@android:color/white"
            app:cornerRadius="16dp"
            app:iconPadding="8dp" />

        <!-- Carga -->
        <ProgressBar
            android:id="@+id/cargarProgreso"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginTop="32dp" />
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
