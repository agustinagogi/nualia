<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/fondo_nualia"
    android:padding="16dp"
    android:fillViewport="true">

    <LinearLayout
        android:id="@+id/contentLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Etiqueta: Título -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/editar_titulo"
            android:textSize="16sp"
            android:textStyle="bold"
            android:layout_marginBottom="8dp" />

        <EditText
            android:id="@+id/etTitulo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/titulo_de_la_tarea"
            android:textColorHint="@color/texto"
            android:textSize="16sp"
            android:background="@drawable/bg_edittext"
            android:padding="12dp"
            android:importantForAutofill="no"
            android:inputType="textCapSentences"
            android:layout_marginBottom="16dp" />

        <!-- Etiqueta: Fecha y hora -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/editar_fecha"
            android:textSize="16sp"
            android:textStyle="bold"
            android:layout_marginBottom="8dp" />

        <EditText
            android:id="@+id/campoFecha"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/dia_y_hora"
            android:textColorHint="@color/texto"
            android:textSize="16sp"
            android:background="@drawable/bg_edittext"
            android:padding="12dp"
            android:focusable="false"
            android:clickable="true"
            android:importantForAutofill="no"
            android:inputType="none"
            android:layout_marginBottom="16dp" />

        <!-- Checkbox: Hecha -->
        <CheckBox
            android:id="@+id/checkHecho"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/hecha"
            android:textSize="16sp"
            android:layout_marginBottom="16dp" />

        <!-- Notificación -->
        <LinearLayout
            android:id="@+id/layoutNotificacion"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="24dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/notificar"
                android:textSize="16sp"
                android:textColor="@color/texto" />

            <ImageView
                android:id="@+id/iconoNotificar"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:layout_marginStart="8dp"
                android:src="@drawable/ic_notificacion_desactivada"
                android:clickable="true"
                android:focusable="true"
                android:contentDescription="@string/notificacion" />
        </LinearLayout>

        <!-- Botón Guardar -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnGuardar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/guardar_cambios"
            android:textAllCaps="false"
            android:backgroundTint="@color/botones"
            android:textColor="@android:color/white"
            android:padding="12dp"
            app:cornerRadius="16dp"
            app:iconPadding="8dp" />

        <!-- Botón Eliminar -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnEliminar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/boton_eliminar"
            android:backgroundTint="@color/botones"
            android:textColor="@android:color/white"
            app:cornerRadius="16dp"
            app:iconPadding="8dp" />

        <!-- ProgressBar -->
        <ProgressBar
            android:id="@+id/cargarProgreso"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginTop="32dp" />
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
