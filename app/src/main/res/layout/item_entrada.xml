<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:card_view="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="8dp"
    card_view:cardCornerRadius="12dp"
    card_view:cardElevation="4dp"
    android:background="@color/white">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:baselineAligned="false"
        android:orientation="horizontal"
        android:padding="12dp"
        android:gravity="center_vertical">

        <!-- Contenedor para ícono y check -->
        <FrameLayout
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginEnd="12dp">

            <!-- Icono -->
            <ImageView
                android:id="@+id/tipoIcono"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerInside"
                android:background="@drawable/bg_icono_circulo" />

            <!-- CheckBox -->
            <CheckBox
                android:id="@+id/checkHecho"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:buttonTint="?attr/colorPrimary"
                android:visibility="gone" />

        </FrameLayout>

        <!-- Contenido -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_weight="1">

            <TextView
                android:id="@+id/tvTitulo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/titulo_de_la_entrada_item"
                android:textStyle="bold"
                android:textSize="16sp"
                android:maxLines="1"
                android:ellipsize="end"/>

            <TextView
                android:id="@+id/tvSubtitulo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/hora_descripcion"
                android:textSize="14sp"
                android:textColor="@color/texto"
                android:maxLines="2"
                android:ellipsize="end"/>

        </LinearLayout>
    </LinearLayout>

</androidx.cardview.widget.CardView>
