<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme -->
    <style name="Theme.Nualia3" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <!-- Primary brand color -->
        <item name="colorPrimary">#6E9B6B</item>
        <item name="colorPrimaryVariant">#6E9B6B</item>
        <item name="colorOnPrimary">@color/white</item>

        <!-- Secondary brand color -->
        <item name="colorSecondary">@color/teal_200</item>
        <item name="colorSecondaryVariant">@color/teal_200</item>
        <item name="colorOnSecondary">@color/black</item>

        <item name="android:statusBarColor">#6E9B6B</item>
        <item name="android:navigationBarColor">#1E1A17</item>
    </style>

    <!-- Base application theme for Material3 (optional) -->
    <style name="Base.Theme.Nualia3" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">#6E9B6B</item>
        <item name="colorPrimaryVariant">#6E9B6B</item>
        <item name="colorOnPrimary">@color/white</item>

        <item name="colorSecondary">@color/teal_200</item>
        <item name="colorSecondaryVariant">@color/teal_700</item>
        <item name="colorOnSecondary">@color/black</item>

        <item name="android:statusBarColor">#6E9B6B</item>
        <item name="android:navigationBarColor">#1E1A17</item>
    </style>
</resources>
